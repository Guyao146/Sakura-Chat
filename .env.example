# 服务端口
PORT=3000

# JWT 签名密钥（生产环境务必改成一段长随机字符串）
JWT_SECRET=please-change-me-to-a-long-random-string

# 可选：启用 HTTPS/WSS（传输层加密）。把证书放到 server/data/ 下并取消注释：
# SSL_KEY_PATH=server/data/key.pem
# SSL_CERT_PATH=server/data/cert.pem

# 反向代理信任白名单（默认空，不接受客户端伪造的转发头）。仅填实际代理 IP/CIDR。
# 同机 Nginx 可用 loopback；Docker 中需填写实际代理容器地址，不要信任所有地址。
# TRUST_PROXY=loopback

# === 可选：第三方登录（标准 OAuth2/OIDC） ===
# 内置两个提供方：Sakura（SakuraID / Sakura-Auth-Server）与 Authentik。
# 只需 OAUTH_<ID>_ISSUER + OAUTH_<ID>_CLIENT_ID 两项即启用；不配置则登录页只显示本地登录。
# CLIENT_SECRET 留空 = 公开客户端（PKCE，浏览器侧推荐）；填写 = 机密客户端（Basic 认证）。
# OAUTH_SAKURA_ISSUER=https://sso.example.com
# OAUTH_SAKURA_CLIENT_ID=app-xxxxxxxxx
# OAUTH_SAKURA_CLIENT_SECRET=
# OAUTH_SAKURA_NAME=Sakura          # 按钮显示名（默认 Sakura）
# OAUTH_AUTHENTIK_ISSUER=https://auth.example.com/application/o/sakura-chat
# OAUTH_AUTHENTIK_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxx
# OAUTH_AUTHENTIK_CLIENT_SECRET=
# OAUTH_AUTHENTIK_NAME=Authentik
# 回调地址固定为 <本站地址>/api/auth/oauth/<id>/callback，需在 IdP 侧登记。
# 反向代理后浏览器地址与本机 Host 不一致时，显式声明本站对外地址：
# APP_BASE_URL=https://chat.example.com
